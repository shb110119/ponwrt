#!/bin/sh /etc/rc.common
# vnstatd 看门狗：库停止更新 / 时间跑到未来就重启 vnstat（见 /usr/bin/vnstat-watch）
#
# 用 /bin/sh 显式解释执行，不依赖文件的执行位——overlay 里的权限位在打包时可能被抹掉，
# 之前就因为这个 procd 起了个 644 的脚本，直接 exec 失败，看门狗等于没装。

START=96
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh /usr/bin/vnstat-watch
	procd_set_param respawn 600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
