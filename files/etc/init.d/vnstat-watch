#!/bin/sh /etc/rc.common
# vnstatd 看门狗：库超过 30 分钟没更新就重启 vnstat（见 /usr/bin/vnstat-watch）

START=96
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/vnstat-watch
	procd_set_param respawn 600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
