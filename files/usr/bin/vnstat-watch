#!/bin/sh
# vnstatd 看门狗 + 开机智能启动
#
# 职责一（开机）：vnstat 的 init 脚本在开机时若发现"库最后写入时间跑在本机时间之前"
#   （典型场景：无 RTC，时钟慢 8 小时，NTP 还没同步），会推迟启动。
#   本脚本在时钟追上库的那一刻调用 /etc/init.d/vnstat start 把它拉起来；
#   超过 30 分钟还没追上（NTP 失联）则兜底强启，宁可时间不对也不空转。
#
# 职责二（运行中）：vnstatd 进程活着但不再写库时自动重启。
#   判据：库 updated 与本机时间相差超过 15 分钟（卡死）或跑到未来 2 分钟以上。
#   连续 3 次救不回来则退避 30 分钟。
#
# 巡检节奏：开机前 15 分钟每 60 秒一次（等 NTP），之后每 2 分钟一次。

MAXAGE=900       # 落后超过 15 分钟视为卡死
FUTURE=-120      # updated 比本机时间还晚 2 分钟以上，同样视为异常
LOGFILE=/var/log/vnstat-watch.log

[ -x /usr/sbin/vnstatd ] || exit 0

log() {
	logger -t vnstat-watch "$*"
	{
		tail -n 200 "$LOGFILE" 2>/dev/null
		echo "$(date '+%F %T') $*"
	} > /tmp/vnstat-watch.tmp 2>/dev/null && mv /tmp/vnstat-watch.tmp "$LOGFILE"
}

vnstatd_running() {
	ps w 2>/dev/null | grep -q '[v]nstatd'
}

# vnstatd 没在跑就拉起；init 里的门闸会在时钟没追上库时自动推迟，
# 所以这里只需要反复尝试，不用自己判断时间
ensure_running() {
	vnstatd_running && return 0

	/etc/init.d/vnstat start >/dev/null 2>&1

	if vnstatd_running; then
		log "vnstatd 未在运行，已由看门狗拉起"
	else
		[ "${bootwait_noted:-0}" = 0 ] && {
			log "时钟还没追上库，vnstatd 继续等待（init 门闸推迟）"
			bootwait_noted=1
		}
	fi
}

stuck() {
	upd=$(vnstat --json 2>/dev/null | jsonfilter -e '@.interfaces[0].updated.timestamp' 2>/dev/null)

	case "$upd" in
		''|*[!0-9]*)
			# 没有库 / 刚建库 / 接口都没在监控，不折腾
			return 1
			;;
	esac

	now=$(date +%s)
	age=$((now - upd))

	if [ "$age" -gt "$MAXAGE" ] || [ "$age" -lt "$FUTURE" ]; then
		DBT=$(date -d "@$upd" '+%F %T' 2>/dev/null)
		log "vnstatd 疑似卡住：库 updated=${DBT:-$upd} 本机=$(date '+%F %T')，相差 ${age}s"
		return 0
	fi

	return 1
}

fails=0

restart_vnstat() {
	fails=$((fails + 1))
	log "重启 vnstat（第 ${fails} 次）"
	/etc/init.d/vnstat restart >/dev/null 2>&1

	if [ "$fails" -ge 3 ]; then
		log "连续 3 次重启仍未恢复，30 分钟后再试"
		fails=0
		sleep 1800
	fi
}

bootwait_noted=0

# 开机阶段：前 15 分钟每 60 秒查一次，尽快跟上 NTP 校准
sleep 60
i=0
while [ "$i" -lt 15 ]; do
	ensure_running
	stuck && restart_vnstat
	i=$((i + 1))
	sleep 60
done

# 稳定运行阶段：每 2 分钟查一次
while :; do
	ensure_running
	stuck && restart_vnstat
	sleep 120
done
