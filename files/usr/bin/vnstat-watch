#!/bin/sh
# vnstatd 看门狗
#
# 症状：流量页「最近 24 小时」右半边没有曲线，vnstat 自己的日/月汇总也停在某个时间点。
# 此时 vnstatd 进程通常还活着，但库的「最后更新时间」不再前进。
#
# 已知诱因：
#   1) 开机时系统时钟还没校准（本地 RTC 与 NTP 差 8 小时很常见）。vnstatd 起来时看到
#      库里的最后更新时间"在未来"，等满 timesyncwait 后就放弃，之后一段时间都不再落盘，
#      直到真实时间追上那个未来时刻——表现就是"早上一停，傍晚自己好"。
#   2) vnstatd 卡在 syncing / 计数器回绕校准里，进程活着但不再写库。
#
# 处理：开机后 15 分钟内每 60 秒查一次（多数情况下时钟 3~5 分钟内就被 NTP 拨正，
# 这时重启一次 vnstat 立刻恢复），之后每 2 分钟查一次。判据是库的 updated 与本机时间
# 相差超过 15 分钟、或 updated 跑到未来 2 分钟以上。连续 3 次没救回来则退避 30 分钟。

MAXAGE=900       # 落后超过 15 分钟视为卡死
FUTURE=-120      # updated 比本机时间还晚 2 分钟以上，同样视为异常
LOGFILE=/var/log/vnstat-watch.log

[ -x /usr/sbin/vnstatd ] || exit 0

log() {
	logger -t vnstat-watch "$*"
	{
		tail -n 200 "$LOGFILE" 2>/dev/null
		echo "$(date '+%F %T') $*"
	} > /tmp/vnstat-watch.tmp 2>/dev/null && mv /tmp/vnstat-watch.tmp "$LOGFILE"
}

stuck() {
	upd=$(vnstat --json 2>/dev/null | jsonfilter -e '@.interfaces[0].updated.timestamp' 2>/dev/null)

	case "$upd" in
		''|*[!0-9]*)
			# 没有库 / 刚建库 / 接口都没在监控，不折腾
			return 1
			;;
	esac

	now=$(date +%s)
	age=$((now - upd))

	if [ "$age" -gt "$MAXAGE" ] || [ "$age" -lt "$FUTURE" ]; then
		DBT=$(date -d "@$upd" '+%F %T' 2>/dev/null)
		log "vnstatd 疑似卡住：库 updated=${DBT:-$upd} 本机=$(date '+%F %T')，相差 ${age}s"
		return 0
	fi

	return 1
}

fails=0

restart_vnstat() {
	fails=$((fails + 1))
	log "重启 vnstat（第 ${fails} 次）"
	/etc/init.d/vnstat restart >/dev/null 2>&1

	if [ "$fails" -ge 3 ]; then
		log "连续 3 次重启仍未恢复，30 分钟后再试"
		fails=0
		sleep 1800
	fi
}

# 开机阶段：前 15 分钟每 60 秒查一次，尽快跟上 NTP 校准
sleep 60
i=0
while [ "$i" -lt 15 ]; do
	stuck && restart_vnstat
	i=$((i + 1))
	sleep 60
done

# 稳定运行阶段：每 2 分钟查一次
while :; do
	stuck && restart_vnstat
	sleep 120
done
